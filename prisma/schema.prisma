generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ozon'daki ürünü cache'ler. offerId bizim SKU'muz, ozonProductId Ozon tarafındaki id.
model Product {
  id                    String    @id @default(cuid())
  offerId               String    @unique
  ozonProductId         String?
  name                  String
  price                 String
  costPrice             String?
  oldPrice              String?
  currencyCode          String    @default("USD")
  weightGrams           Int?
  unitsInPack           Int?      // Kutu/paket içindeki adet — varyanttan varyanta farklı olabiliyor (örn. "1 adet" / "6 adet"), weightGrams gibi ürüne özel; Ozon'un "Birimler tek bir üründe" (id 8962) attribute'una otomatik senkronlanır
  heavyPackaging        Boolean   @default(false) // Metal kutu/ağır ambalaj gibi ürünlerde işaretlenir — paketleme payı (normalde %35) %65'e çıkar (bkz. src/pricing/formula.ts HEAVY_PACKAGING_BUFFER)
  // Bu varyantın maliyet/ağırlığının "kaça katlanarak" hesaplandığı taban varyant (örn. 6'lı
  // Display varyantı, tekil "1 Piece" varyantının offerId'sine işaret eder) — costPrice/weightGrams
  // = taban.costPrice/weightGrams × unitsInPack olarak "Yeniden Hesapla" ile senkronlanabilir.
  // Kutu/Display gibi toplu varyantları restore ederken kullanılıyor (bkz. src/scripts/restore-bulk-pack-variants.ts).
  packBaseOfferId       String?
  widthCm               Int?
  heightCm              Int?
  depthCm               Int?
  descriptionCategoryId Int?
  typeId                Int?
  draftAttributes       Json? // Ozon'a gönderilmeden önce toplu/elle önceden doldurulmuş attribute cevapları (id/value/dictionaryValueId) — ürün açıldığında forma otomatik yükleniyor
  images                Json?
  status                String    @default("draft") // draft | ready | pending | imported | failed
  stockQuantity         Int?      // Ozon'a en son gönderilen stok adedi (rFBS depo: Çekmeköy)
  importTaskId          BigInt?
  lastError             String?
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Shopify CSV içe aktarımından gelen alanlar
  shopifyHandle     String?
  shopifyVariantId  String?
  shopifyVendor     String?
  shopifyType       String?
  originalImages    Json? // Shopify'dan gelen orijinal görsel URL'leri, dokunulmamış — "eski görsel" copy/keep için
  shopifyMetafields Json? // CSV'deki Flavor/Chocolate type/Color/Country vb. ham metafield değerleri, attribute ön-doldurma için
  descriptionHtml   String? // Shopify Body (HTML) — Gemini çevirisi için kaynak
  modelGroupId      String?
  modelGroup        ModelGroup? @relation(fields: [modelGroupId], references: [id])
  nameRu            String? // Gemini çevirisi cache
  descriptionRu     String?
  // true ise bu varyant "pasif" — handle Ozon'a gönderilirken atlanır, silinmiyor (geri
  // aktifleştirilebilir). Kalıcı silme için deleteHandles/ExcludedOfferId kullanılıyor.
  excludedFromSubmit Boolean @default(false)
  // Shopify CSV'sindeki orijinal varyant sırası (0-based) — offerId alfabetik sıralaması
  // Shopify'ın gerçek varyant sırasıyla uyuşmuyor (örn. "SKU-BOX" "SKU"'dan önce gelebiliyor),
  // bu yüzden handle sayfasında "ilk varyant" (görsel/isim/vendor referansı) bunu kullanıyor.
  variantPosition Int @default(0)

  orderItems OrderItem[]

  @@index([shopifyHandle])
  @@index([modelGroupId])
  @@index([shopifyVendor])
  @@index([shopifyType])
}

// Kullanıcının /import'tan bilerek sildiği offerId'ler — CSV tekrar import edilirse
// (örn. yeni bir alan eklenip mevcut satırlar güncellenmek istendiğinde) bu ürünlerin
// "hayalet" gibi geri gelmemesi için upsert bu tabloyu kontrol edip atlıyor.
model ExcludedOfferId {
  offerId   String   @id
  createdAt DateTime @default(now())
}

// Farklı Shopify ürünlerini (handle) tek Ozon kartında birleştirmek için — 9048 model name attribute'una karşılık gelir.
model ModelGroup {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())

  products Product[]
}

// FBS/FBO siparişi, postingNumber Ozon tarafındaki benzersiz sipariş numarası.
model Order {
  id            String   @id @default(cuid())
  postingNumber String   @unique
  status        String
  scheme        String // fbs | fbo
  orderDate     DateTime?
  rawPayload    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  offerId   String
  quantity  Int
  price     String

  // Aynı sipariş senkronize edilirken kalemler silinip yeniden oluşturuluyor (bkz. syncFbsOrders),
  // bu yüzden id yerine bu ikili üzerinden idempotentlik garanti edilmiyor ama tekilliği sağlıyor.
  @@unique([orderId, offerId])
}

// posting_number bazında finans/kesinti verisi (komisyon, kargo, diğer kesintiler).
// postingNumber kasıtlı olarak Order'a FK ile bağlı DEĞİL — finans işlemleri (iade, servis
// bedeli, FBO vb.) sipariş senkronizasyon penceremizin dışındaki veya hiç Order'a düşmeyen
// posting'lere referans verebiliyor; FK zorunlu olsaydı bu satırlar sync'i patlatırdı.
// Order ile ilişki uygulama katmanında postingNumber üzerinden manuel join edilir (bkz. getOrderDetail).
model FinanceTransaction {
  id             String   @id @default(cuid())
  postingNumber  String
  operationId    BigInt   @unique // Ozon'un operation_id'si — yeniden senkronizasyonda tekrar satır oluşmasını (upsert) engellemek için
  operationType  String
  operationDate  DateTime
  amount         Float
  commissionAmount Float?
  deliveryCharge Float?
  otherCharges   Float?
  rawPayload     Json?
  createdAt      DateTime @default(now())

  @@index([postingNumber])
}
