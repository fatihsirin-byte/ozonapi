generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ozon'daki ürünü cache'ler. offerId bizim SKU'muz, ozonProductId Ozon tarafındaki id.
model Product {
  id                    String    @id @default(cuid())
  offerId               String    @unique
  ozonProductId         String?
  name                  String
  price                 String
  costPrice             String?
  oldPrice              String?
  currencyCode          String    @default("USD")
  weightGrams           Int? // Net ağırlık (ürünün kendi ağırlığı, paketleme hariç)
  cargoWeightGrams      Int? // Kargo (faturalanacak) ağırlık — weightGrams değişince otomatik hesaplanır (computeBillingWeightGrams), ama elle de düzeltilebilir
  // true ise bu ürünün gerçek (tartılmış) ağırlığı sipariş ekranından bir kere girildi — bir
  // daha sorulmaz. Girildiğinde weightGrams/cargoWeightGrams gerçek değere eşitlenir (paketleme
  // payı tekrar eklenmez, zaten ölçülen değer kargoya çıkan gerçek ağırlıktır) ve fiyat yeniden hesaplanır.
  weightConfirmed       Boolean   @default(false)
  unitsInPack           Int?      // Kutu/paket içindeki adet — varyanttan varyanta farklı olabiliyor (örn. "1 adet" / "6 adet"), weightGrams gibi ürüne özel; Ozon'un "Birimler tek bir üründe" (id 8962) attribute'una otomatik senkronlanır
  heavyPackaging        Boolean   @default(false) // Metal kutu/ağır ambalaj gibi ürünlerde işaretlenir — paketleme payı (normalde %35) %65'e çıkar (bkz. src/pricing/formula.ts HEAVY_PACKAGING_BUFFER)
  // Bu varyantın maliyet/ağırlığının "kaça katlanarak" hesaplandığı taban varyant (örn. 6'lı
  // Display varyantı, tekil "1 Piece" varyantının offerId'sine işaret eder) — costPrice/weightGrams
  // = taban.costPrice/weightGrams × unitsInPack olarak "Yeniden Hesapla" ile senkronlanabilir.
  // Kutu/Display gibi toplu varyantları restore ederken kullanılıyor (bkz. src/scripts/restore-bulk-pack-variants.ts).
  packBaseOfferId       String?
  // ASE (xlive.ase.com.tr) gümrük/ETGB entegrasyonu için GTİP (HS kodu) override — panelde ürün
  // düzenleme ekranından elle girilir. Doluysa ASE'ye gönderilirken bu kullanılır, boşsa Ozon'a
  // zaten girilmiş öneri (bkz. suggestHsCodesForOrder, orders.service.ts) kullanılır (2026-09-12,
  // kullanıcı talebi/kararı).
  gtipOverride          String?
  widthCm               Int?
  heightCm              Int?
  depthCm               Int?
  descriptionCategoryId Int?
  typeId                Int?
  draftAttributes       Json? // Ozon'a gönderilmeden önce toplu/elle önceden doldurulmuş attribute cevapları (id/value/dictionaryValueId) — ürün açıldığında forma otomatik yükleniyor
  images                Json?
  status                String    @default("draft") // draft | ready | pending | imported | failed
  stockQuantity         Int?      // Ozon'a en son gönderilen stok adedi (rFBS depo: Çekmeköy)
  importTaskId          BigInt?
  lastError             String?
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Shopify CSV içe aktarımından gelen alanlar
  shopifyHandle     String?
  shopifyVariantId  String?
  shopifyVendor     String?
  shopifyType       String?
  originalImages    Json? // Shopify'dan gelen orijinal görsel URL'leri, dokunulmamış — "eski görsel" copy/keep için
  shopifyMetafields Json? // CSV'deki Flavor/Chocolate type/Color/Country vb. ham metafield değerleri, attribute ön-doldurma için
  descriptionHtml   String? // Shopify Body (HTML) — Gemini çevirisi için kaynak
  modelGroupId      String?
  modelGroup        ModelGroup? @relation(fields: [modelGroupId], references: [id])
  nameRu            String? // Gemini çevirisi cache
  descriptionRu     String?
  // true ise bu varyant "pasif" — handle Ozon'a gönderilirken atlanır, silinmiyor (geri
  // aktifleştirilebilir). Kalıcı silme için deleteHandles/ExcludedOfferId kullanılıyor.
  excludedFromSubmit Boolean @default(false)
  // Shopify CSV'sindeki orijinal varyant sırası (0-based) — offerId alfabetik sıralaması
  // Shopify'ın gerçek varyant sırasıyla uyuşmuyor (örn. "SKU-BOX" "SKU"'dan önce gelebiliyor),
  // bu yüzden handle sayfasında "ilk varyant" (görsel/isim/vendor referansı) bunu kullanıyor.
  variantPosition Int @default(0)

  orderItems OrderItem[]

  @@index([shopifyHandle])
  @@index([modelGroupId])
  @@index([shopifyVendor])
  @@index([shopifyType])
}

// Kullanıcının /import'tan bilerek sildiği offerId'ler — CSV tekrar import edilirse
// (örn. yeni bir alan eklenip mevcut satırlar güncellenmek istendiğinde) bu ürünlerin
// "hayalet" gibi geri gelmemesi için upsert bu tabloyu kontrol edip atlıyor.
model ExcludedOfferId {
  offerId   String   @id
  createdAt DateTime @default(now())
}

// Farklı Shopify ürünlerini (handle) tek Ozon kartında birleştirmek için — 9048 model name attribute'una karşılık gelir.
model ModelGroup {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())

  products Product[]
}

// FBS/FBO siparişi, postingNumber Ozon tarafındaki benzersiz sipariş numarası.
model Order {
  id            String   @id @default(cuid())
  postingNumber String   @unique
  status        String
  scheme        String // fbs | fbo
  orderDate     DateTime?
  rawPayload    Json?
  purchaseInvoiceNumber String? // Bizim kendi takibimiz için — tedarikçiden aldığımız alış faturasının numarası (Ozon'a gönderilmez)
  // Paraşüt'te bu sipariş için kesilmiş satış faturası — dolu ise buton tekrar fatura kesmez,
  // var olanı gösterir (2026-09-09, kullanıcı talebi: sipariş başına manuel, tek tek fatura).
  parasutInvoiceId String?
  parasutInvoiceNo String?
  parasutPrintUrl  String?
  // true ise fatura kesilirken e-Arşiv adımı (GİB'e gönderme) başarısız oldu — bu durumda PDF
  // arayan uçlar (bkz. src/parasut/eArchives.ts resolveInvoicePdf) tekrar deneyebilir. false ise
  // e-Arşiv gönderimi zaten kabul edilmiş demektir — o zaman TEKRAR createEArchive çağırmak GERÇEK,
  // ikinci bir e-Arşiv başvurusuna yol açabilir (2026-09-09'da code review'da tespit edildi), bu
  // yüzden false iken sadece "hazır olana kadar bekle" denir, yeniden gönderim denenmez.
  parasutEArchiveFailed Boolean @default(false)
  // false ise parasutInvoiceNo hâlâ GEÇİCİ olabilir — e-Arşiv oluşunca Paraşüt faturayı GİB'e
  // kayıtlı KENDİ resmi seriyle yeniden numaralandırıyor (bkz. src/parasut/orderInvoice.ts) ama bu
  // ANINDA olmuyor. true olana kadar PDF durumu her kontrol edildiğinde gerçek numara TEKRAR
  // denenir (bkz. app/api/orders/[postingNumber]/parasut-invoice/pdf/route.ts) — süreye dayalı bir
  // pencere (ör. "ilk 30 dakika") KULLANILMIYOR, çünkü GİB o gün yavaşsa numara kalıcı olarak yanlış
  // kalabilirdi (2026-09-10'da code review'da tespit edildi). true olduktan sonra bir daha
  // denenmez — zaten kesin numara elde edilmiş, gereksiz Paraşüt isteği atılmaz.
  parasutInvoiceNoConfirmed Boolean @default(false)
  // "Bugün faturası kesilenler" filtresi (TSİ bazında) için — createdAt/updatedAt başka
  // sebeplerle de değişebildiğinden fatura anını ayrı tutuyoruz (2026-09-09, kullanıcı talebi).
  parasutInvoicedAt DateTime?
  // Fatura kesilirken kullanılan o günkü USD/TL kuru (bkz. src/parasut/orderInvoice.ts) — TL satış
  // tutarını GERÇEK faturayla birebir eşleşecek şekilde kalıcı göstermek için (2026-09-10, kullanıcı
  // talebi). Fatura kesilmemiş ya da bu alan eklenmeden önce kesilmiş siparişlerde null kalır —
  // o durumda liste ekranı günün CANLI kuruyla tahmini bir TL değeri gösterir (bkz. app/orders/page.tsx).
  parasutInvoiceFxRate Float?
  // true ise PDF diskimize (private-uploads/parasut-invoices/{postingNumber}.pdf) bir kere
  // indirilip kaydedildi — bir daha ASLA Paraşüt'ten canlı çekilmesine gerek yok (2026-09-10,
  // kullanıcı talebi: "her fatura oluşunca PDF olarak içeri alsak" — hem tek tek "Faturayı Aç"
  // butonları hem toplu ZIP indirme artık önce buraya bakıyor, bkz. src/parasut/pdfCache.ts).
  // PDF gerçek müşteri adı/adres/tutar içerdiği için public/uploads (auth'suz) DEĞİL, sadece
  // giriş yapmış kullanıcıya açık bir API route üzerinden servis ediliyor.
  parasutInvoicePdfCached Boolean @default(false)
  // "Topla" (shipOrder) çift tıklama/iki sekme korumasının kilidi — BİLEREK "status" alanının
  // dışında ayrı bir alan: 15 dakikada bir çalışan sync cron'u (syncFbsOrders) "status"ü Ozon'dan
  // gelen gerçek değerle EZİYOR, o yüzden kilidi status'e yazarsak cron kilidi silip çift gerçek
  // sevkiyat isteğine yol açabilirdi (2026-09-10'da code review'da tespit edildi — aynı riski
  // Paraşüt fatura kilidi de ayrı bir alanla, parasutInvoiceId, çözüyor). Başarılı bir sevkiyattan
  // sonra BİLEREK null'a geri döndürülmüyor (denetim izi + "bu sipariş bizim butonumuzla
  // paketlendi" kaydı olarak kalıyor).
  shipClaimedAt DateTime?
  // ASE (xlive.ase.com.tr) gümrük/ETGB entegrasyonu — fatura numarası KESİNLEŞTİĞİ an (bkz.
  // parasutInvoiceNoConfirmed, app/api/orders/[postingNumber]/parasut-invoice/pdf/route.ts) bir
  // kez gönderilir (bkz. src/ase/orderShipment.ts sendOrderToAse). Hata durumunda da bu alanlar
  // dolar (aseShipmentSuccess=false + aseShipmentMessage) — fatura akışını ENGELLEMEZ, sadece
  // sonucu kaydeder (2026-09-12, kullanıcı talebi).
  aseShipmentSentAt     DateTime?
  aseShipmentSuccess    Boolean?
  aseShipmentMessage    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items        OrderItem[]

  // Siparişler sayfasındaki filtre butonları (durum bazlı groupBy + "Bugün Faturası Kesilenler"
  // sayacı) her sayfa yüklemesinde bu iki alanı sorguluyor — index olmadan tüm tablo taranıyordu
  // (2026-09-10'da code review'da tespit edildi).
  @@index([status])
  @@index([parasutInvoicedAt])
  // Analitik sayfasındaki "En Çok Satan Ürünler" ve ürün detayındaki "Satış Geçmişi" grafiği artık
  // local veriden hesaplanıyor (bkz. orders.service.ts getTopSellingProducts/getProductSalesHistory)
  // — ikisi de orderDate aralığına göre filtreliyor (2026-09-11'de code review'da tespit edildi).
  @@index([orderDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  offerId   String
  ozonSku   BigInt? // Ozon'un posting içindeki NUMERİK sku'su (offer_id'den farklı — bizim kendi kodumuz
                     // yerine Ozon'un ürün eşleştirmesi için kullandığı kimlik). Fatura (hs_codes) gibi
                     // Ozon'a geri gönderilen isteklerde offerId DEĞİL bu kullanılmalı (2026-08-13'te
                     // "posting doesn't contain product_id" hatasıyla tespit edildi).
  quantity  Int
  price     String

  // Kargo Kontrolü sekmesinde kullanıcı bu kalemin gerçek kargo kesintisini gözden geçirip
  // işaretlediğinde true olur — resync'te upsert ile korunur (bkz. syncFbsOrders), üzerine yazılmaz.
  shippingReviewed Boolean @default(false)

  // Aynı sipariş senkronize edilirken kalemler silinip yeniden oluşturuluyor (bkz. syncFbsOrders),
  // bu yüzden id yerine bu ikili üzerinden idempotentlik garanti edilmiyor ama tekilliği sağlıyor.
  @@unique([orderId, offerId])
}

// posting_number bazında finans/kesinti verisi (komisyon, kargo, diğer kesintiler).
// postingNumber kasıtlı olarak Order'a FK ile bağlı DEĞİL — finans işlemleri (iade, servis
// bedeli, FBO vb.) sipariş senkronizasyon penceremizin dışındaki veya hiç Order'a düşmeyen
// posting'lere referans verebiliyor; FK zorunlu olsaydı bu satırlar sync'i patlatırdı.
// Order ile ilişki uygulama katmanında postingNumber üzerinden manuel join edilir (bkz. getOrderDetail).
//
// 2026-09-09: Ozon, bu tabloyu beslediğimiz /v3/finance/transaction/list uç noktasını KAPATTI
// ("obsolete method cannot be used" — 6 Temmuz 2026'da duyurulmuş, bu hesapta ~23 Ağustos'ta
// devreye girmiş). Yerine posting_number bazlı /v1/finance/accrual/postings kullanılıyor (bkz.
// finance.service.ts, syncAccrualsForPostings). O uç nokta operation_id vermiyor (idempotentlik
// için artık senkronize edilen postingNumber'lar için satırlar silinip yeniden yazılıyor, upsert
// değil) ve tek bir "operasyon" yerine tek tek "accrual" (tahakkuk) satırları veriyor — her satır
// tek bir kategoriye (komisyon/kargo/diğer) giriyor, bu yüzden commissionAmount/deliveryCharge/
// otherCharges üçünden sadece biri dolu oluyor artık (eskiden aynı operasyonda ikisi birden dolu
// olabiliyordu). Alan isimleri ve bu tabloyu okuyan sayfalar (orders/page.tsx, order detail,
// getPnlSummary) değişmeden kalsın diye şekli korundu.
model FinanceTransaction {
  id             String   @id @default(cuid())
  postingNumber  String
  operationId    BigInt?  // yeni accrual uç noktası artık vermiyor — eski (Ağustos öncesi) satırlarda var
  operationType  String
  operationDate  DateTime
  amount         Float
  commissionAmount Float?
  deliveryCharge Float?
  otherCharges   Float?
  currency       String?  // Ozon artık bunu açıkça veriyor (RUB) — eski uç nokta hiç vermiyordu
  rawPayload     Json?
  createdAt      DateTime @default(now())

  @@index([postingNumber])
}
